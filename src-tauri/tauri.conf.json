{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Steam Achievement For Stream",
  "version": "1.0.0",
  "identifier": "com.pakwaf.steamachievementforstream",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Steam Custom Achievements",
        "width": 1150,
        "height": 780,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "url": "index.html#/"
      },
      {
        "label": "overlay",
        "title": "Steam Custom Achievements Overlay",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "fullscreen": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "url": "index.html#/overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
