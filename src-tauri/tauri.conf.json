{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Steam Achievement For Stream",
  "version": "1.2.0",
  "identifier": "com.steamoverlay.stream",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Steam Custom Achievements",
        "width": 1150,
        "height": 780,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "url": "index.html#/"
      },
      {
        "label": "overlay",
        "title": "Steam Custom Achievements Overlay",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "fullscreen": false,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "x": 0,
        "y": 0,
        "url": "index.html#/overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": "1FEE0B76269F0643914DED79B89C5DA6740E8A7E",
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "wix": {
        "language": "fr-FR"
      },
      "nsis": {
        "languages": [
          "French",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Pakwaf/Steam-Achievement-For-Stream/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFCM0E2QzJBOUI1ODlFQjgKUldTNG5saWJLbXc2cXpYcEdCd0xsMDhkZWlkMklZbmc2U3JRQ0xoTW41ZFhqRGhJanEyb2RvVHEK",
      "dialog": false
    }
  }
}
